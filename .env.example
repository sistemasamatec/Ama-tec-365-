# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# ERP AMA TEC 365 (BUKULO GESTE) — CREDENCIAIS FIREBASE ADMIN (SECRETS)
# ==============================================================================
# Configure estas variáveis no painel Secrets do AI Studio:
ERP_FIREBASE_PROJECT_ID=""
ERP_FIREBASE_CLIENT_EMAIL=""
ERP_FIREBASE_PRIVATE_KEY=""
# Alternativa recomendada para evitar problemas de formatação/quebras de linha:
# ERP_FIREBASE_PRIVATE_KEY_B64="" (chave PEM codificada em base64)
ERP_FIRESTORE_DATABASE_ID=""

# ==============================================================================
# PORTAL DO CLIENTE (OPCIONAL)
# ==============================================================================
# O botão de consulta de assistência só é visível se esta variável estiver definida.
VITE_AMATEC365_PORTAL_URL=""

# ==============================================================================
# PROTEÇÃO ANTI-SPAM (CLOUDFLARE TURNSTILE / GOOGLE RECAPTCHA)
# ==============================================================================
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# ==============================================================================
# FIREBASE ADMIN SDK — BASE DE DADOS DO SITE (MANTIDA)
# ==============================================================================
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ==============================================================================
# NOTIFICAÇÕES & EMAILS (OPCIONAL)
# ==============================================================================
EMAIL_NOTIFICATION_TARGET=""
RESEND_API_KEY=""
